(func foldl (f acc lst)
    (cond (isnull lst) 
        acc
        (foldl 
            f 
            (f acc (head lst))
            (tail lst)
        )
    )
)

(setq lst '(1 2 3 4 5))

(setq myPlus (eval 'plus))
(func myLen (a _) (plus a 1))

(foldl (eval 'plus) 0 lst)  // funny behaviour, need to fix parser

(foldl myPlus 0 lst)
(foldl myLen 0 lst)
